<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Queues BoxOpportunityFileMoveQueueable, which moves loose files at the top of the Opportunity folder to the Matter&apos;s Client Uploads folder and the Opportunity&apos;s Client Account files to the Matter&apos;s Client Account folder, reads each file back from Box to confirm it landed, and posts failures to the system health Slack channel. Replaced the box__MoveFile loops, whose fault paths dropped every failed move silently.</description>
        <name>Move_Opportunity_Files_Verified</name>
        <label>Move Opportunity Files (Verified)</label>
        <locationX>600</locationX>
        <locationY>170</locationY>
        <actionName>BoxOpportunityFileMoveQueueable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>matterId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>BoxOpportunityFileMoveQueueable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>BOX: Move Opportunity Files To Matter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BOX: Move Opportunity Files To Matter</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>600</locationX>
        <locationY>50</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Box_Matter_Folder_ID__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AcctSeed__Opportunity__c</field>
